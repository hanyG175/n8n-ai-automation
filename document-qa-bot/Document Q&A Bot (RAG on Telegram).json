    {
      "parameters": {
        "jsCode": "const rawAnswer = $json.output || $json.text || $json.response;\n\nconst citationRegex = /\\[source:\\s*([^\\]]+)\\]/gi;\nconst citationsFound = new Set();\nlet match;\n\nwhile ((match = citationRegex.exec(rawAnswer)) !== null) {\n  citationsFound.add(match[1].trim());\n}\n\nconst cleanBody = rawAnswer.replace(citationRegex, '').replace(/\\s{2,}/g, ' ').trim();\nconst footer = citationsFound.size\n  ? `\\n\\n📎 Sources: ${Array.from(citationsFound).join(', ')}`\n  : '\\n\\n⚠️ No specific source found for this answer.';\n\nreturn [{\n  json: {\n    finalMessage: cleanBody + footer,\n    sources: Array.from(citationsFound)\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
