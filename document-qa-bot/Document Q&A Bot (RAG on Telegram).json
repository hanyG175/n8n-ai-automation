    {
      "parameters": {
        "jsCode": "// Checks similarity scores from the retriever. If nothing scored high\n// enough, we flag it so the IF node can skip the AI Agent entirely\n// and avoid a confidently-wrong answer.\n\nconst RELEVANCE_THRESHOLD = 0.6;\n\nconst matches = $input.all().map(item => item.json);\n\n// Adjust '.score' to match whatever field your retriever node actually\n// outputs — in raw Pinecone queries it's usually `score`, but n8n's\n// Vector Store Retriever node sometimes nests it under `metadata` or\n// returns it as part of a `document` object. Check one execution's\n// output in the UI before trusting this.\nconst scores = matches.map(m => m.score ?? m.metadata?.score ?? 0);\nconst topScore = scores.length ? Math.max(...scores) : 0;\n\nreturn [{\n  json: {\n    noMatch: topScore < RELEVANCE_THRESHOLD,\n    topScore,\n    matchCount: matches.length\n  }\n}];"
      },
