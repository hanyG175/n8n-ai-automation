      "parameters": {
        "jsCode": "const fileName = $('Check If PDF').first().json.message.document.file_name;\nconst PINECONE_API_KEY = $vars.PINECONE_API_KEY;\nconst PINECONE_INDEX_HOST = 'https://telerag-mi2qb9j.svc.aped-4627-b74a.pinecone.io';\n\nconst response = await helpers.httpRequest({\n  method: 'POST',\n  url: `${PINECONE_INDEX_HOST}/vectors/delete`,\n  headers: {\n    'Api-Key': PINECONE_API_KEY,\n    'Content-Type': 'application/json'\n  },\n  body: {\n    namespace: '',\n    filter: { fileName: { '$eq': fileName } }\n  },\n  json: true\n});\n\n// Make sure binary data from the previous step ('Get a file') is passed forward!\nconst binaryData = $('Get a file').first().binary;\n\nreturn [{\n  json: {\n    fileName,\n    deleteStatus: 'ok',\n    response\n  },\n  binary: binaryData // <--- PASS BINARY DATA FORWARD\n}];"
      },
