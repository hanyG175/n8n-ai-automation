        "jsCode": "// 1. Get the raw payload string from the webhook body\nconst rawPayload = $input.first().json.body?.body?.payload || $input.first().json.body?.payload;\n\n// 2. Parse the stringified JSON into a real object\nconst data = typeof rawPayload === 'string' ? JSON.parse(rawPayload) : rawPayload;\n\n// 3. Extract the action ID (e.g., \"deny_email\" or \"approve_email\")\nconst action = data?.actions?.[0]?.action_id || null;\n\n// Extract the combined value string from Slack's action payload\nconst actionValue = data?.actions?.[0]?.value || '';\n\n// Split by slash\nconst [message_id, thread_id] = actionValue.split('/');\n\n// 4. Extract main message text\nconst messageText = data?.message?.text || '';\n\n// 5. Extract texts from blocks\nconst blockTexts = data?.message?.blocks\n  ?.filter(b => b.text?.text)\n  .map(b => b.text.text) || [];\n\nreturn [{\n  json: {\n    action, \n    message_id,\n    thread_id,                // \"deny_email\"\n    messageText,                               // \"Approve sending the reply email \"\n    emailTo: blockTexts[0].slice(28) || '',         // \"*Validate Email To Send*\\nTo: Hani Gaouaou...\"\n    emailSubject: blockTexts[1].slice(11) || '',\n    // \"Re: ...\"\n    emailBody: blockTexts[2] || ''            // \"Hello Aisha, thank you for reaching out...\"\n  }\n}];"
      },
