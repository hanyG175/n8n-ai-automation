    {
      "parameters": {
        "jsCode": "function findBody(parts, mimeType) {\n  for (const part of parts || []) {\n    if (part.mimeType === mimeType && part.body?.data) {\n      return part.body.data;\n    }\n    if (part.parts) {\n      const found = findBody(part.parts, mimeType);\n      if (found) return found;\n    }\n  }\n  return null;\n}\n\nfunction base64UrlDecode(data) {\n  const base64 = data.replace(/-/g, '+').replace(/_/g, '/');\n  return Buffer.from(base64, 'base64').toString('utf-8');\n}\n\nconst payload = $json.payload;\nlet bodyData = null;\n\nif (payload.body?.data) {\n  // single-part email, body sits directly on payload\n  bodyData = payload.body.data;\n} else if (payload.parts) {\n  // multipart email — prefer plain text, fall back to HTML\n  bodyData = findBody(payload.parts, 'text/plain') || findBody(payload.parts, 'text/html');\n}\n\nconst fullBody = bodyData ? base64UrlDecode(bodyData).replace(/<[^>]+>/g, '') : $json.snippet; // last-resort fallback\n\nreturn [{ json: { ...$json, fullBody } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
