    {
      "parameters": {
        "jsCode": "// Keep this in sync with the URL on the Fetch Target Page node.\n// For multi-URL monitoring, replace this constant with a value read\n// from a config sheet/table instead (see notes below).\nconst TARGET_URL = 'http://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html';\nconst crypto = require('crypto');\nconst item = $input.first().json;\nconst rawPrice = (item.price || '').trim();\nconst priceNumber = parseFloat(rawPrice.replace(/[^0-9.]/g, ''));\nconst availability = (item.availability || '').replace(/\\\\s+/g, ' ').trim();\nconst title = (item.title || '').trim();\nconst fingerprint = crypto  .createHash('sha256')  .update(`${priceNumber}|${availability}`)  .digest('hex');\nreturn [{  \n  json: {    \n    url: TARGET_URL,    \n    title,    \n    price: priceNumber, \n    priceRaw: rawPrice, \n    availability,    \n    fingerprint,    \n    checkedAt: new Date().toISOString()  \n  }}];"
      },
      "id": "47ddf330-61e6-4070-ba63-9a343746b9a0",
      "name": "Normalize & Fingerprint",
      "type": "n8n-nodes-base.code",
