        1120,
        16
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const current = $('Normalize & Fingerprint').first().json;\nconst previous = $('Get Last Known State').first()?.json || {};\nconst oldPrice = parseFloat(previous.price) || null;\nconst newPrice = parseFloat(current.price);\nconst pctChange = oldPrice ? (((newPrice - oldPrice) / oldPrice) * 100).toFixed(1) : null;\nreturn [{  \n  json: \n  {    ...current,\n       oldPrice,\n       oldAvailability: previous.availability || 'unknown',    \n       pctChange, \n       diffText: `Title: ${current.title}\n       Old price: ${oldPrice ?? 'n/a'}\n       New price: ${newPrice}\n       Change: ${pctChange ?? 'n/a'}%\n       Old stock: ${previous.availability || 'unknown'}\n       New stock: ${current.availability}`  }}];"
      },
      "id": "623b08dc-3805-45ac-beef-1e6cd5654736",
